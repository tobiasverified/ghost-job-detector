# Copy to .env for `vercel dev`. Never put these values in the extension.

# Required for the hosted checks, shared storage, and the daily cleanup.

# Tavily web search. Repost and review searches fail closed without it.
TAVILY_API_KEY=
# Groq chat completions. Employer-name resolution fails closed without it.
GROQ_API_KEY=
# RapidAPI key for Glassdoor ratings and the optional pay comparison.
RAPIDAPI_KEY=
# NewsData layoff search. A missing key is an error, and the layoff step uses the public search instead.
NEWSDATA_API_KEY=
# Project URL, https://YOUR_PROJECT.supabase.co. Without it, cache and limits stay in memory for that process.
SUPABASE_URL=
# Service role key. The SQL grants this role only; the anon key has no access.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token for GET /api/cleanup. The daily cron returns 401 until this is set.
CRON_SECRET=

# Optional. Empty means the default described on the line.

# HMAC key for visitor IP hashes. If empty, the server derives one from another secret already set.
IP_HASH_SECRET=
# HMAC secret for invite keys. Required only after REQUIRE_INVITE_KEY is true, and for scripts/create-invite-key.mjs.
INVITE_KEY_SECRET=
# Set to true to require a signed invite key. Unset or any other value leaves the server open.
REQUIRE_INVITE_KEY=
# Comma-separated invite key ids to reject. Empty means none.
REVOKED_KEY_IDS=
# UTC-day cap for Tavily. Default 40.
TAVILY_DAILY_LIMIT=
# UTC-day cap for RapidAPI. Default 25.
RAPIDAPI_DAILY_LIMIT=
# UTC-day cap for Groq. Default 40.
GROQ_DAILY_LIMIT=
# UTC-day cap for NewsData. Default 25.
NEWSDATA_DAILY_LIMIT=
# Requests per hashed IP per hour. Default 300.
RATE_LIMIT_PER_HOUR=
# Set to 1, true, or on to include the hiring-ratio points. Off when empty.
RATIO_ENABLED=
# Set to 1, true, or on to compare posted pay with a market estimate. Off when empty.
PAY_COMPARE_ENABLED=
# Set to 1, true, yes, or on to skip the company careers-page fetch.
CAREERS_PAGE_DISABLED=
# Optional headcount source. Still read by the employee lookup; skipped when empty.
CRUNCHBASE_API_KEY=
# Optional headcount source, tried after the earlier sources. Skipped when empty.
APOLLO_API_KEY=
# Set by Vercel on deploy. Leave empty locally. Stored on the check row as deployment_id.
VERCEL_DEPLOYMENT_ID=
